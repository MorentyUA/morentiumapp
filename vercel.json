{
          "rewrites": [
                        {
                                          "source": "/api/(.*)",
                                          "destination": "/api/$1"
                        },
                        {
                                          "source": "/(.*)",
                                          "destination": "/index.html"
                        }
          ],
          "functions": {
                        "api/youtube.ts": {
                                          "includeFiles": "api/_youtube/**"
                        },
                        "api/private-cron.ts": {
                                          "maxDuration": 30
                        }
          },
          "crons": [
                        {
                                          "path": "/api/private-cron",
                                          "schedule": "0 0 * * *"
                        }
          ]
}
